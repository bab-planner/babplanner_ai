# 이미지에는 서비스 소스와 식수 예측 research 소스만 필요하다.
# 학습 산출물(data/models/outputs)은 build 단계에서 새로 만든다. 로컬 것을 넣지 않는다.

.git
.gitignore
.idea
.pytest_cache
**/__pycache__
**/*.pyc
**/*.egg-info

# 가상환경
.venv
.venv-*
**/.venv

# 로컬 생성물, 비밀
.env
.env.*
!.env.example
outputs
reports
data

# 이 이미지에 필요 없는 연구/데모/테스트
demo
tests
docs
research/cctv_counting
research/waste_estimation

# 식수 예측 학습 산출물은 build 단계가 만든다
research/demand_forecasting/data
research/demand_forecasting/models
research/demand_forecasting/outputs
