.venv/
# 연구용 환경. torch/CUDA가 들어가므로 서비스 환경과 분리한다.
.venv-cctv/
# 잔반 트랙 전용. CCTV 환경을 고정해 두기 위해 따로 둔다.
.venv-waste/
__pycache__/
.pytest_cache/
*.pyc
*.pyo
.env
.env.*
!.env.example
*.egg-info/
build/
dist/

# 실제 수집 데이터. 급식 사진에는 사람이 찍혀 있을 수 있다.
data/*
!data/README.md

# --- CCTV 연구 트랙 ---
# 영상 원본과 결과물. CCTV 영상에는 사람이 찍혀 있고, annotated 영상도
# 마찬가지다. 저장소에 들어가면 되돌릴 수 없다.
outputs/
research/cctv_counting/datasets/raw/
research/cctv_counting/experiments/*
!research/cctv_counting/experiments/README.md
# 실험 결과 중 작은 기록 파일만 예외로 남긴다. 영상은 위/아래 규칙이 막는다.
!research/cctv_counting/experiments/*/
research/cctv_counting/experiments/*/*
!research/cctv_counting/experiments/*/*.json
!research/cctv_counting/experiments/*/*.yaml
!research/cctv_counting/experiments/*/*.csv
*.mp4
*.avi
*.mov
*.mkv

# 모델 weight. 라이브러리 캐시에 두고 받아 쓴다.
*.pt
*.pth
*.onnx
*.engine
*.trt

# --- 잔반 연구 트랙 (AI-2) ---
# 급식 사진에는 사람이 찍혀 있을 수 있다. 실험 디렉터리도 같은 규칙을 쓴다.
research/waste_estimation/data/
research/waste_estimation/experiments/*
!research/waste_estimation/experiments/README.md
!research/waste_estimation/experiments/*/
research/waste_estimation/experiments/*/*
!research/waste_estimation/experiments/*/*.json
!research/waste_estimation/experiments/*/*.yaml
!research/waste_estimation/experiments/*/*.csv
# 공개 데이터를 받으면 여기 둔다. 커밋하지 않는다.
research/waste_estimation/datasets/raw/

# annotations/ 의 CSV 템플릿은 tracked다(위 규칙에 걸리지 않는다).
# 실제 annotation을 채운 파일은 개인정보 판단 후 별도로 결정한다.
