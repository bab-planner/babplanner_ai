# 실제 값을 여기에 적지 않는다. 키 이름만 둔다.
# 로컬 셸 환경 변수로만 주입한다.
APP_ENV=

# 수요 예측 / 발주 추천 구현 선택. disabled | fixture
# 기본값은 disabled다. 끄면 숫자를 만들지 않고 503을 돌려준다.
# 운영에서 fixture를 고르면 기동에 실패한다.
DEMAND_MODEL_MODE=
PROCUREMENT_MODEL_MODE=

AI_SERVICE_TOKEN=

# 식수 예측(demand-forecast) artifact와 이력 위치. 비우면 research/demand_forecasting 아래 기본 경로.
# 파일이 없어도 서버는 뜨고, 식수 예측만 unavailable/503이 된다.
# 합성데이터 모델은 APP_ENV=production 에서 기본적으로 로드하지 않는다(strict).
# 실데이터를 구할 수 없는 PoC 단계에서 운영이 합성 PoC 예측을 내게 하려면
# DEMAND_FORECAST_MODE=poc 로 명시한다. strict | poc, 기본값 strict.
# poc여도 fixture 구현(DEMAND/PROCUREMENT_MODEL_MODE=fixture)은 운영에서 계속 금지다.
# 응답과 status(modelKind=SYNTHETIC_POC, syntheticData=true)는 합성 PoC임을 계속 밝힌다.
DEMAND_FORECAST_MODE=
DEMAND_FORECAST_MODEL_PATH=
DEMAND_FORECAST_METADATA_PATH=
DEMAND_HISTORY_PATH=
DEMAND_CCTV_LOG_PATH=

# --- CCTV demo collector (demo/cctv_collector) ---
# 수집기가 Spring 내부 수집 경로를 부를 때 쓴다.
# BAPPLANNER_INTERNAL_SERVICE_TOKEN 은 Spring이 **받는** 토큰이고,
# 위의 AI_SERVICE_TOKEN(Spring이 FastAPI로 **보내는** 토큰)과 다른 값이다.
# 하나를 돌려쓰면 한쪽이 새는 순간 양쪽이 같이 뚫린다.
BAPPLANNER_BACKEND_BASE_URL=
BAPPLANNER_INTERNAL_SERVICE_TOKEN=
