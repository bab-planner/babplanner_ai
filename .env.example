# 실제 값을 여기에 적지 않는다. 키 이름만 둔다.
# 로컬 셸 환경 변수로만 주입한다.
APP_ENV=
WASTE_MODEL_MODE=

# 수요 예측 / 발주 추천 구현 선택. disabled | fixture
# 기본값은 disabled다. 끄면 숫자를 만들지 않고 503을 돌려준다.
# 운영에서 fixture를 고르면 기동에 실패한다.
DEMAND_MODEL_MODE=
PROCUREMENT_MODEL_MODE=

AI_SERVICE_TOKEN=

# --- CCTV demo collector (demo/cctv_collector) ---
# 수집기가 Spring 내부 수집 경로를 부를 때 쓴다.
# BAPPLANNER_INTERNAL_SERVICE_TOKEN 은 Spring이 **받는** 토큰이고,
# 위의 AI_SERVICE_TOKEN(Spring이 FastAPI로 **보내는** 토큰)과 다른 값이다.
# 하나를 돌려쓰면 한쪽이 새는 순간 양쪽이 같이 뚫린다.
BAPPLANNER_BACKEND_BASE_URL=
BAPPLANNER_INTERNAL_SERVICE_TOKEN=
